# Set these in Netlify project environment variables, available to Functions.
# Netlify's built-in storage uses STORAGE_BACKEND=netlify-blobs instead of DB_*.
# Leave unset for the original hosted-MySQL backend.
# STORAGE_BACKEND=netlify-blobs
DB_HOST=your-hosted-mysql-host
DB_PORT=3306
DB_NAME=decab_db
DB_USER=decab_app
DB_PASS=replace-with-database-password
DB_SSL=true
# Optional PEM certificate supplied by your database provider.
DB_SSL_CA=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
# Local development only: DB_SSL=false for XAMPP; COOKIE_SECURE=false for HTTP.
COOKIE_SECURE=true
AWS_LAMBDA_JS_RUNTIME=nodejs22.x
